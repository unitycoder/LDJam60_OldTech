' LDJAM 60 : Old Tech
' Snake Temple
' Player needs to get the treasure from the temple, but the temple is guarded by snakes. The player needs to avoid the snakes and get the treasure.
' Can also kill snakes by hitting them (moving over them on your movement tick)
' HP: gain hp from potions?
' snake spawners?

W% = 60
H% = 40
SCREEN W%, H%
CLS 0
COLOR 15, 1
'LOCATE 1, 2 : PRINT "Snake Temple 2"

' uBasic Paint decoder: 1 char per pixel, 0-F = colour, . = transparent
SUB DrawHex(ux%, uy%, uw%, ud$)
  FOR ubi% = 0 TO LEN(ud$) - 1
    ubc% = INSTR("0123456789ABCDEF", MID$(ud$, ubi% + 1, 1)) - 1
    IF ubc% >= 0 THEN PSET (ux% + ubi% MOD uw%, uy% + ubi% \ uw%), ubc%
  NEXT ubi%
END SUB

' ux = x pos, uy = ypos, uw = width, uh = height, ud = data string
SUB DrawMap(ux%, uy%, uw%, ud$)
  FOR ubi% = 0 TO LEN(ud$) - 1
    ubc% = INSTR("0123456789ABCDEF", MID$(ud$, ubi% + 1, 1)) - 1
    IF ubc% >= 0 THEN
        COLOR 0, 0

        tx% = ux% + ubi% MOD uw%
        ty% = uy% + ubi% \ uw%

        IF ubc% = 0 THEN ' floor
            COLOR 8, 0
            TILE$ = "."
        END IF

        IF ubc% = 8 THEN ' wall
            COLOR 8, 0
            TILE$ = "#"
        END IF

        LOCATE ty%, tx% : PRINT TILE$;
    END IF
  NEXT ubi%
END SUB

' uBasic Paint · 28x15 · HEX
' trimmed from 32x32 canvas at 1,1
DIM SHARED img$
img$ = "...F2F......................"
img$ = img$ + "...222.2...A...A...2.A..2A.."
img$ = img$ + "..2....22..2..2.2..2.2.2...."
img$ = img$ + "..2....2.2.2.2...2.22..2...."
img$ = img$ + "...22..2.2.2.2...2.22..222.."
img$ = img$ + ".....2.2..22.22222.2.2.2...."
img$ = img$ + "..222..2...2.2...2.2.2..22.."
img$ = img$ + "............................"
img$ = img$ + "EEEEE.EEE.E...E.EEE..4...EEE"
img$ = img$ + "4.E...E...EE.EE.E..E.E...E.4"
img$ = img$ + "..E...E...E.E.E.E..E.E...E.."
img$ = img$ + "..E...EEE.E.4.E.EE4..E...EEE"
img$ = img$ + "..E...E.4.E...E.E....E...E.."
img$ = img$ + "..E...E...E...E.E....E...E.."
img$ = img$ + "..6...666.6...6.6....666.666"

' settings
SHOW_INTRO% = 0
DIM SHARED ENEMY_RANGE%
ENEMY_RANGE% = 7


if SHOW_INTRO% = 1 THEN
    ' start menu music
    PLAY "MB T160 O2 L3 MS DEDC DC"

    ' draw start screen
    FOR i% = 45 TO 6 STEP -1
      CLS 0
      DrawHex 16, i%, 28, img$
      WAIT
      WAIT
    NEXT i%

    ' fake loader
    FOR i% = 0 TO 8
        SOUND 10+RND(100), RND
        FOR x% = 0 TO W%
          PSET (0, RND(H%)), RND(15)
          PSET (W%-1, RND(H%)), RND(15)
        NEXT x%
    NEXT i%
    ' clear borders
    FOR y% = 0 TO H%
        PSET (0, y%), 0
        PSET (W%-1, y%), 0
        'WAIT
        SOUND 220-y%, 0.11
    NEXT y%
END IF

CLS 0


' game
W% = 320
H% = 218
DIM SHARED GW%
DIM SHARED GH%
GW% = W%/6
GH% = H%/8
SCREEN W%, H%
COLOR 15, 0

' player data
px% = 1
py% = GH%/2-1
DIM SHARED php%
php% = 10

' goal
DIM SHARED trx%, try%, got_treasure%
trx% = GW%-8
try% = GH%/2+6
got_treasure% = 0

SUB DrawPlayer(px%, py%)
  COLOR 15, 0
  LOCATE py%, px% : PRINT "@";
END SUB

SUB UI
  COLOR 7, 0
  LOCATE GH%-1, 0 : PRINT "HP:";php%;

  IF got_treasure%=0 THEN
      COLOR 0,6
      LOCATE GH%-1, GW%-15 : PRINT " Find Treasure!";
  ELSE
      COLOR 0,14
      LOCATE GH%-1, GW%-16 : PRINT " Treasure Found!";
  END IF
END SUB

SUB DrawTreasure
    IF got_treasure% = 0 THEN
        COLOR 14, 0
        LOCATE try%, trx% : PRINT "$";

        COLOR 7, 0
        LOCATE GH%-1, 9 : PRINT "[";
        COLOR 7, 0
        LOCATE GH%-1, 11 : PRINT "]";
    ELSE ' in inventory
        COLOR 7, 0
        LOCATE GH%-1, 9 : PRINT "[";
        COLOR 14, 0
        LOCATE GH%-1, 10 : PRINT "$";
        COLOR 7, 0
        LOCATE GH%-1, 11 : PRINT "]";
    END IF
END SUB

' uBasic Paint · 53x26 · HEX
DIM SHARED map$
map$ = "88888888888888888888888888888888888888888888888888888"
map$ = map$ + "80000000000000000000000000000000000000000000000000008"
map$ = map$ + "80000000000000000000000000000000000000000000000000008"
map$ = map$ + "80000000000000000000000000000000000000000000000000008"
map$ = map$ + "80000000000000000000000000000000000000000088888880008"
map$ = map$ + "80000000000000000000000000000000000000000080000080008"
map$ = map$ + "80000000000000000000000000000000000000000080000080008"
map$ = map$ + "80000000000000000000000000000000000000000000000080008"
map$ = map$ + "80000000000000000000000000000000000000000000000080008"
map$ = map$ + "80000000000000000000000000000000000000000080000080008"
map$ = map$ + "80000000000000000000000000000000000000000080000080008"
map$ = map$ + "88000000000000000000000000000000000000888880000080008"
map$ = map$ + "80000000000000000000000000000000000000000000000000008"
map$ = map$ + "88000000000000000000000000000000000000000000000000008"
map$ = map$ + "80000000000000000000000000000000000000888880000080008"
map$ = map$ + "80000000000000000000000000000000000000000080000080008"
map$ = map$ + "80000000000000000000000000000000000000000080000080008"
map$ = map$ + "80000000000000000000000000000000000000000000000080008"
map$ = map$ + "80000000000000000000000000000000000000000000000080008"
map$ = map$ + "80000000000000000000000000000000000000000080000080008"
map$ = map$ + "80000000000000000000000000000000000000000080000080008"
map$ = map$ + "80000000000000000000000000000000000000000088888880008"
map$ = map$ + "80000000000000000000000000000000000000000000000000008"
map$ = map$ + "80000000000000000000000000000000000000000000000000008"
map$ = map$ + "80000000000000000000000000000000000000000000000000008"
map$ = map$ + "88888888888888888888888888888888888888888888888888888"

CLS 0
'DrawMap 0, 0, 60, 40, map$

SUB UpdateEnemies(px%,py%)
    FOR i% = 0 TO ecount% - 1
        ' if dead
        IF ehp%(i%) <= 0 THEN
            'COLOR 8, 0
            'LOCATE ey%(i%), ex%(i%) : PRINT "!";
        ELSE
            ' calculate distance to player
            dx% = px% - ex%(i%)
            dy% = py% - ey%(i%)

            ' player is in range, move towards player
            if ABS(dx%) <= ENEMY_RANGE% AND ABS(dy%) <= ENEMY_RANGE% THEN
                IF ABS(dx%) > ABS(dy%) THEN
                    IF dx% > 0 THEN ex%(i%) = ex%(i%) + 1: ELSE ex%(i%) = ex%(i%) - 1
                ELSE
                    IF dy% > 0 THEN ey%(i%) = ey%(i%) + 1: ELSE ey%(i%) = ey%(i%) - 1
                END IF
            ELSE
                ' player is out of range, move randomly
                IF RND(100) < 50 THEN
                    ex%(i%) = ex%(i%) + (RND(3) - 1) ' move left/right randomly
                ELSE
                    ey%(i%) = ey%(i%) + (RND(3) - 1) ' move up/down randomly
                END IF
            END IF

            ' clamp to play area
            IF ex%(i%)<1 THEN ex%(i%) = 1
            IF ex%(i%)>GW%-2 THEN ex%(i%) = GW%-2
            IF ey%(i%)<1 THEN ey%(i%) = 1
            IF ey%(i%)>GH%-2 THEN ey%(i%) = GH%-2

            ' check collision to obstacles in map (only 0 is walkable)
            IF MID$(map$, ex%(i%) + ey%(i%) * 53 + 1, 1) <> "0" THEN
                ' move back to previous position
                IF ABS(dx%) > ABS(dy%) THEN
                    IF dx% > 0 THEN ex%(i%) = ex%(i%) - 1: ELSE ex%(i%) = ex%(i%) + 1
                ELSE
                    IF dy% > 0 THEN ey%(i%) = ey%(i%) - 1: ELSE ey%(i%) = ey%(i%) + 1
                END IF
            END IF

            ' check collision with player
            IF ex%(i%) = px% AND ey%(i%) = py% THEN
                php% = php% - 1
            END IF

            ' check collision with other enemies
            FOR j% = 0 TO ecount% - 1
                IF i% <> j% THEN
                    IF ex%(i%) = ex%(j%) AND ey%(i%) = ey%(j%) THEN
                        ' move back to previous position
                        IF ABS(dx%) > ABS(dy%) THEN
                            IF dx% > 0 THEN ex%(i%) = ex%(i%) - 1: ELSE ex%(i%) = ex%(i%) + 1
                        ELSE
                            IF dy% > 0 THEN ey%(i%) = ey%(i%) - 1: ELSE ey%(i%) = ey%(i%) + 1
                        END IF
                    END IF
                END IF
            NEXT

            COLOR 12, 0
            LOCATE ey%(i%), ex%(i%) : PRINT "S";
        END IF
    NEXT
END SUB

SUB DrawEnemies
    FOR i% = 0 TO ecount% - 1
        COL% = 2
        IF ehp%(i%) <= 0 THEN COL% = 4
        COLOR COL%, 0
        LOCATE ey%(i%), ex%(i%) : PRINT "s";
    NEXT
END SUB

' 1s delay
if SHOW_INTRO% = 1 THEN
    SOUND 32000, 18.2
    PLAY "T160 O1 L4 CDECDEFAFA"
    SOUND 666,0.33
    DrawPlayer(px%, py%)
END IF

' enemies
CONST ecount% = 10

DIM SHARED ex%(ecount%), ey%(ecount%), ehp%(ecount%)
' initial positions
FOR i% = 0 TO ecount% - 1
    ex%(i%) = (GW%/2)+RND(GW%/2-4)
    ey%(i%) = 1+RND(GH%-3)
    ehp%(i%) = 1
NEXT


' main loop
DO
    CLS 0

    MOVED% = 0
    BLOCKED% = 0

    ' --- player input ---
    IF KEY(KEY_LEFT%) OR KEY(ASC("A")) THEN
        px% = px% - 1
        MOVED% = 1
    END IF

    IF MOVED% = 0 AND (KEY(KEY_RIGHT%) OR KEY(ASC("D"))) THEN
        px% = px% + 1
        MOVED% = 1
    END IF

    IF MOVED% = 0 AND (KEY(KEY_UP%)  OR KEY(ASC("W"))) THEN
        py% = py% - 1
        MOVED% = 1
    END IF

    IF MOVED% = 0 AND (KEY(KEY_DOWN%) OR KEY(ASC("S"))) THEN
        py% = py% + 1
        MOVED% = 1
    END IF

    ' check collision to obstacles in map (only 0 is walkable)
    IF MID$(map$, px% + py% * 53 + 1, 1) <> "0" THEN
        ' move back to previous position
        IF KEY(KEY_LEFT%) OR KEY(ASC("A")) THEN
            px% = px% + 1
        END IF
        IF KEY(KEY_RIGHT%) OR KEY(ASC("D")) THEN
            px% = px% - 1
        END IF
        IF KEY(KEY_UP%)  OR KEY(ASC("W")) THEN
            py% = py% + 1
        END IF
        IF KEY(KEY_DOWN%) OR KEY(ASC("S")) THEN
            py% = py% - 1
        END IF
        BLOCKED% = 1
    END IF

    KILLED_ENEMY% = 0
    ' check collision with enemies
    FOR i% = 0 TO ecount% - 1
        IF px% = ex%(i%) AND py% = ey%(i%) AND ehp%(i%) > 0 THEN
            ' player hits enemy first
            KILLED_ENEMY% = 1
            ehp%(i%) = ehp%(i%) - 1
        END IF
    NEXT

    ' check collision to treasure
    IF got_treasure% = 0 AND px% = trx% AND py% = try% THEN
        got_treasure% = 1
        COLOR 14, 0
        LOCATE GH%-1, GW%-16 : PRINT " Treasure Found!";
    END IF

    DrawMap 0, 0, 53, map$
    if (MOVED% = 1) THEN UpdateEnemies(px%, py%)
    DrawEnemies
    DrawTreasure
    DrawPlayer(px%, py%)
    UI
    
    IF BLOCKED% = 0 AND MOVED% = 1 THEN SOUND 10+RND(100),0.1
    IF BLOCKED% = 1 THEN SOUND RND(80),0.5
    IF KILLED_ENEMY% = 1 THEN
        SOUND 100+RND(100),0.5
        COLOR 12, 0
        LOCATE GH%-1, GW%-13 : PRINT "Killed snake!";
    END IF
    IF got_treasure% = 1 THEN
        got_treasure% = 2
        PLAY "MB T160 O1 L4 CDECDEFAFA"
    END IF

    WAIT
LOOP
