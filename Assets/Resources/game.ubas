map$ = map$ + "80000000000000000000000000000000000000000000000000008"
map$ = map$ + "88888888888888888888888888888888888888888888888888888"

CLS 0
DrawMap 0, 0, 53, map$

SUB UpdateEnemies(px%,py%)
    FOR i% = 0 TO ecount% - 1
        ' if dead them dont move
        IF ehp%(i%) <= 0 THEN
            'COLOR 8, 0
            'LOCATE ey%(i%), ex%(i%) : PRINT "!";
        ELSE
            ' calculate distance to player
            dx% = px% - ex%(i%)
            dy% = py% - ey%(i%)

            ' movable value
            mx% = 0
            my% = 0

            ' player is in range, move towards player
            if ABS(dx%) <= ENEMY_RANGE% AND ABS(dy%) <= ENEMY_RANGE% THEN
                ' if x distance is greater than y distance, move in x direction, else move in y direction
                IF ABS(dx%) > ABS(dy%) THEN
                    'IF dx% > 0 THEN ex%(i%) = ex%(i%) + 1: ELSE ex%(i%) = ex%(i%) - 1
                    IF dx% > 0 THEN mx%= 1: ELSE mx% = -1
                ELSE
                    'IF dy% > 0 THEN ey%(i%) = ey%(i%) + 1: ELSE ey%(i%) = ey%(i%) - 1
                    IF dy% > 0 THEN my%= 1: ELSE my% = -1
                END IF
            ELSE
                ' player is out of range, move randomly
                IF RND(100) < 50 THEN
                    mx% = (RND(3) - 1)
                    'ex%(i%) = ex%(i%) + mx% ' move left/right randomly
                ELSE
                    my% = (RND(3) - 1)
                    'ey%(i%) = ey%(i%) + my% ' move up/down randomly
                END IF
            END IF

            ex%(i%) = ex%(i%) + mx%
            ey%(i%) = ey%(i%) + my%

            ' clamp to play area
            IF ex%(i%)<1 THEN ex%(i%) = 1
            IF ex%(i%)>GW%-2 THEN ex%(i%) = GW%-2
            IF ey%(i%)<1 THEN ey%(i%) = 1
            IF ey%(i%)>GH%-2 THEN ey%(i%) = GH%-2

            ' check collision to obstacles in map (only 0 is walkable)
            IF MID$(map$, ex%(i%) + ey%(i%) * 53 + 1, 1) <> "0" THEN
                ' move back to previous position
                ex%(i%) = ex%(i%) - mx%
                ey%(i%) = ey%(i%) - my%
            END IF

            ' check collision with player
            IF ex%(i%) = px% AND ey%(i%) = py% THEN
                php% = php% - 1
            END IF

            ' check collision with other enemies
            FOR j% = 0 TO ecount% - 1
                IF i% <> j% THEN
                    IF ex%(i%) = ex%(j%) AND ey%(i%) = ey%(j%) THEN
                        ' move back to previous position
                        ex%(i%) = ex%(i%) - mx%
                        ey%(i%) = ey%(i%) - my%
                    END IF
                END IF
            NEXT

            COLOR 12, 0
            LOCATE ey%(i%), ex%(i%) : PRINT "S";
        END IF
    NEXT
END SUB

SUB DrawEnemies
    FOR i% = 0 TO ecount% - 1
        COL% = 2
        IF ehp%(i%) <= 0 THEN COL% = 4
        COLOR COL%, 0
        LOCATE ey%(i%), ex%(i%) : PRINT "s";
    NEXT
END SUB

' 1s delay
if SHOW_INTRO% = 1 THEN
    SOUND 32000, 18.2
    PLAY "T160 O1 L4 CDECDEFAFA"
    SOUND 666,0.33
    DrawPlayer(px%, py%)
END IF

' enemies
CONST ecount% = 16

DIM SHARED ex%(ecount%), ey%(ecount%), ehp%(ecount%)
' initial positions
FOR i% = 0 TO ecount% - 1
    ex%(i%) = (GW%/2)+RND(GW%/2-4)
    ey%(i%) = 1+RND(GH%-3)
    ehp%(i%) = 1
NEXT


' main loop
DO WHILE php% > 0 AND goal_reached% = 0
    CLS 0

    MOVED% = 0
    BLOCKED% = 0

    ' --- player input ---
    IF KEY(KEY_LEFT%) OR KEY(ASC("A")) THEN
        px% = px% - 1
        MOVED% = 1
    END IF

    IF MOVED% = 0 AND (KEY(KEY_RIGHT%) OR KEY(ASC("D"))) THEN
        px% = px% + 1
        MOVED% = 1
    END IF

    IF MOVED% = 0 AND (KEY(KEY_UP%)  OR KEY(ASC("W"))) THEN
        py% = py% - 1
        MOVED% = 1
    END IF

    IF MOVED% = 0 AND (KEY(KEY_DOWN%) OR KEY(ASC("S"))) THEN
        py% = py% + 1
        MOVED% = 1
    END IF

    ' check collision to obstacles in map (only 0 is walkable)
    IF MID$(map$, px% + py% * 53 + 1, 1) <> "0" THEN
        ' move back to previous position
        IF KEY(KEY_LEFT%) OR KEY(ASC("A")) THEN
            px% = px% + 1
        END IF
        IF KEY(KEY_RIGHT%) OR KEY(ASC("D")) THEN
            px% = px% - 1
        END IF
        IF KEY(KEY_UP%)  OR KEY(ASC("W")) THEN
            py% = py% + 1
        END IF
        IF KEY(KEY_DOWN%) OR KEY(ASC("S")) THEN
            py% = py% - 1
        END IF
        BLOCKED% = 1
    END IF

    KILLED_ENEMY% = 0
    ' check collision with enemies
    FOR i% = 0 TO ecount% - 1
        IF px% = ex%(i%) AND py% = ey%(i%) AND ehp%(i%) > 0 THEN
            ' player hits enemy first
            KILLED_ENEMY% = 1
            ehp%(i%) = ehp%(i%) - 1
        END IF
    NEXT

    ' check collision to treasure
    IF got_treasure% = 0 AND px% = trx% AND py% = try% THEN
        got_treasure% = 1
        COLOR 14, 0
        LOCATE GH%-1, GW%-16 : PRINT " Treasure Found!";
    END IF

    ' check collision to exit
    IF goal_reached% = 0 AND got_treasure%>0 AND px% = goalx% AND py% = goaly% THEN
        goal_reached% = 1
        COLOR 14, 0
        LOCATE GH%-1, GW%-14 : PRINT " Goal Reached!";
        PLAY "MB T160 O2 L8 CDECFE"
        ' TODO end game screen
    END IF

    ' update objects
    DrawMap 0, 0, 53, map$
    if (MOVED% = 1) THEN UpdateEnemies(px%, py%)
    DrawEnemies
    DrawTreasure
    DrawGoal
    DrawPlayer(px%, py%)
    UI
    
    IF BLOCKED% = 0 AND MOVED% = 1 THEN SOUND 10+RND(100),0.1
    IF BLOCKED% = 1 THEN SOUND RND(80),0.5
    IF KILLED_ENEMY% = 1 THEN
        SOUND 100+RND(100),0.5
        COLOR 12, 0
        LOCATE GH%-1, GW%-13 : PRINT "Killed snake!";
    END IF

    IF got_treasure% = 1 THEN
        got_treasure% = 2
        PLAY "MB T160 O2 L8 CDECFE"
    END IF

    WAIT
LOOP

SUB DRAWFINISH
    DIM SHARED fin$
    fin$ = "...........F..."
    fin$ = fin$ + "...........F..."
    fin$ = fin$ + "...E.E.E.E7F7.."
    fin$ = fin$ + "...EEEEEFFFFFFF"
    fin$ = fin$ + "...6EEE2227F7.."
    fin$ = fin$ + "....EE2EEEEF..."
    fin$ = fin$ + "....EEE22EEF..."
    fin$ = fin$ + "....6EEEE2E6..."
    fin$ = fin$ + ".....E222EE...."
    fin$ = fin$ + ".....6EEEE6...."
    fin$ = fin$ + ".......EE......"
    fin$ = fin$ + ".......EE......"
    fin$ = fin$ + ".......EE......"
    fin$ = fin$ + ".......EE......"
    fin$ = fin$ + "F....F.EE......"
    fin$ = fin$ + ".F..F.6EE6....."
    fin$ = fin$ + "..FF6EEEEEE6..."
    fin$ = fin$ + "..FFEEEEEEEEE6."
    fin$ = fin$ + ".F..F.........."
    fin$ = fin$ + ".....F........."
    DrawHex 8, 2, 15, fin$
END SUB

SUB DRAWGAMEOVER
    DIM SHARED ded$
    ded$ = ".......444..AAA22222222.....4444"
    ded$ = ded$ + ".......4.4.A0F22222222222A...44."
    ded$ = ded$ + "...44444..AF0F2222222222F0A....."
    ded$ = ded$ + "....4.....2F0F2A222222A2F0FA...4"
    ded$ = ded$ + "....4....222222222222222F0F2...4"
    ded$ = ded$ + ".....4...2A2222A222222A22222A..."
    ded$ = ded$ + ".44444..A22A22222222222222A2A..4"
    ded$ = ded$ + "..44....A22222222A22A2222A22A..4"
    ded$ = ded$ + "...44...AA22222F222222222222A..."
    ded$ = ded$ + "....44..2A222FFFF0000F222222A..4"
    ded$ = ded$ + "444444..2A0000FF00000FFF222AA..4"
    ded$ = ded$ + "44.....22A0000FF000000FFF00A...4"
    ded$ = ded$ + ".44...22220000F4000000FF000A...4"
    ded$ = ded$ + "..4...2A224000F405005044000A.444"
    ded$ = ded$ + "444..22AA2200040005500F00042.44."
    ded$ = ded$ + "4...A222AA24000000522040022...4."
    ded$ = ded$ + "..22A2222AA222200222220042.....4"
    ded$ = ded$ + ".2A2AA2222AA222222A222222..44444"
    ded$ = ded$ + "22A222A22222AAA222AAA2......4..."
    ded$ = ded$ + "22AA222AAA2222AAA222AA...44.4..."
    DrawHex 4, 2, 32, ded$
END SUB

' test
'php% = 0
'goal_reached% = 0

' game finished
IF php%>0 AND goal_reached%>0 THEN
    CLS 0
    COLOR 14, 0
    LOCATE GH%/2, GW%/2-6 : PRINT "YOU WIN!";
    PLAY "MB T160 O2 L8 CDECFE"
    '1s delay
    SOUND 32000, 18.2
    SCREEN 32, 24
    DRAWFINISH
ELSE
' game over
    CLS 0
    COLOR 4, 0
    LOCATE GH%/2, GW%/2-6 : PRINT "GAME OVER!";
    PLAY "MB T160 O2 L8 CDECFE"
    '1s delay
    SOUND 32000, 18.2
    SCREEN 32, 24
    DRAWGAMEOVER
END IF


'1s delay
SOUND 32000, 40

'guide, press F5 (refresh to start again)
SCREEN 320,220
CLS 1
LOCATE 13, 12 : PRINT "Press F5 to restart the game.";
